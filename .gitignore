# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli (if used locally)
.supabase
supabase/.temp

# claude code local settings (machine-specific, not shared)
.claude/settings.local.json

# os / editor
Thumbs.db
desktop.ini
.vscode/
.idea/

# FUSE mount artifacts (archivos temporales del montaje; no son del proyecto)
.fuse_hidden*

# carpeta de limpieza pendiente (archivos retirados a la espera de borrado)
_to_delete/
