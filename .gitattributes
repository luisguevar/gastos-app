# Normaliza los saltos de línea a LF en todo el repo (evita el ruido CRLF/LF
# entre Windows y Linux). El repositorio ya está en LF.
* text=auto eol=lf

# Archivos binarios: git no debe tocarlos.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text
*.woff  binary
*.woff2 binary
*.pdf   binary
